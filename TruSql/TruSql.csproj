<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	  <!-- NuGet package metadata -->
	  <PackageId>TruSql</PackageId>
	  <Version>1.0.0</Version>
	  <Description>TruSql is a SQL query builder for dynamically constructing and validating queries at runtime.</Description>
	  <Authors>Indra Putra Gemilang</Authors>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/Indra-Putra2/TruSql</RepositoryUrl>
	  <PackageTags>sql query-builder parser tokenizer ast</PackageTags>
	  <Copyright>Copyright © 2026 Indra Putra Gemilang</Copyright>
  </PropertyGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" />
	<InternalsVisibleTo Include="TruSql.Test" />
	<InternalsVisibleTo Include="TruSqlShowcase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TruSql.Core" Version="1.0.0" />
  </ItemGroup>
</Project>
