<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Build settings -->
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>TruSql.Core</PackageId>
		<Version>1.0.0</Version>
		<Description>Core expression, parsing, and tokenization components for TruSql.</Description>
		<Authors>Indra Putra Gemilang</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Indra-Putra2/TruSql</RepositoryUrl>
		<PackageTags>sql query-builder parser tokenizer ast</PackageTags>
		<Copyright>Copyright © 2026 Indra Putra Gemilang</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>